{
  "name": "review",
  "version": "0.3.0",
  "description": "An in-app code review tab: file tree, inline git-diff highlighting, and per-line comment threads you can hand off to a coding agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "muxy": {
    "description": "An in-app code review tab: file tree, inline git-diff highlighting, and per-line comment threads you can hand off to a coding agent.",
    "permissions": [
      "tabs:read",
      "tabs:write",
      "panes:read",
      "panes:write",
      "projects:read",
      "worktrees:read",
      "commands:exec",
      "notifications:write"
    ],
    "events": [],
    "tabTypes": [
      { "id": "review", "title": "Review", "entry": "tabs/review.html" }
    ],
    "commands": [
      {
        "id": "review:open",
        "title": "Review: Open File Browser",
        "action": { "kind": "openTab", "tabType": "review" }
      }
    ],
    "topbarItems": [
      {
        "id": "review",
        "icon": { "svg": "assets/review.svg" },
        "tooltip": "Open Review",
        "command": "review:open"
      }
    ],
    "marketplace": {
      "author": "Mark Huot",
      "github": "markhuot",
      "categories": ["git", "productivity", "code-review"],
      "icon": "assets/icon.svg",
      "screenshots": ["assets/screenshot-1.png"]
    }
  }
}
