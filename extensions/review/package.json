{
  "name": "review",
  "version": "0.3.0",
  "description": "An in-app code review tab: file tree, inline git-diff highlighting, and per-line comment threads you can hand off to a coding agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.1",
    "@pierre/trees": "1.0.0-beta.4",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "muxy": {
    "description": "An in-app code review tab: file tree, inline git-diff highlighting, and per-line comment threads you can hand off to a coding agent.",
    "permissions": [
      "tabs:read",
      "tabs:write",
      "panes:read",
      "panes:write",
      "projects:read",
      "worktrees:read",
      "commands:exec",
      "notifications:write"
    ],
    "events": [],
    "tabTypes": [
      { "id": "review", "title": "Review", "entry": "tabs/review.html" }
    ],
    "commands": [
      {
        "id": "review:open",
        "title": "Review: Open File Browser",
        "action": { "kind": "openTab", "tabType": "review" }
      }
    ],
    "topbarItems": [
      {
        "id": "review",
        "icon": { "svg": "assets/review.svg" },
        "tooltip": "Open Review",
        "command": "review:open"
      }
    ],
    "marketplace": {
      "author": "Mark Huot",
      "github": "markhuot",
      "categories": ["git", "productivity", "code-review"],
      "icon": "assets/icon.svg",
      "screenshots": ["assets/screenshot-1.png"]
    }
  }
}
