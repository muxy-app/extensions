    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "jsonc-parser": "^3.3.1",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^6.1.200",
    "web-tree-sitter": "^0.26.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "@tree-sitter-grammars/tree-sitter-toml": "^0.7.0",
    "@tree-sitter-grammars/tree-sitter-zig": "^1.1.2",
    "esbuild": "^0.27.7",
    "material-icon-theme": "^5.35.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "vite": "^7.3.5"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "File explorer for Muxy",
    "permissions": [
      "files:read",
      "files:write",
      "panels:write",
      "tabs:write",
      "commands:exec",
      "commands:run-script",
      "git:read"
    ],
    "events": [
      "file.changed",
      "worktree.switched",
      "project.switched",
      "panel.opened"
    ],
    "panels": [
      {
        "id": "files",
        "title": "Files",
        "entry": "panel/index.html",
        "position": "right",
        "mode": "pinned",
        "hiddenControls": [
          "position"
        ],
        "icon": {
          "symbol": "folder"
        },
        "headerButtons": [
          {
            "id": "files-toggle-dirty-filter",
            "icon": {
              "symbol": "line.3.horizontal.decrease"
            },
            "tooltip": "Show only changed files",
            "command": "files-toggle-dirty-filter"
          },
          {
            "id": "files-toggle-icon-theme",
            "icon": {
              "symbol": "paintpalette"
            },
            "tooltip": "Toggle file icon theme",
            "command": "files-toggle-icon-theme"
          },
          {
            "id": "files-collapse-all",
            "icon": {
              "symbol": "rectangle.compress.vertical"
            },
            "tooltip": "Collapse all folders",
            "command": "files-collapse-all"
          }
        ]
      }
    ],
    "tabTypes": [
      {
        "id": "code-editor",
        "title": "Editor",
        "entry": "panel/editor.html"
      }
    ],
    "fileOpeners": [
      {
        "id": "editor",
        "title": "Editor",
        "tabType": "code-editor",
        "patterns": [
          "*"
        ],
        "singleton": false,
