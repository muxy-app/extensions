{
  "name": "modal-demo",
  "version": "0.1.0",
  "muxy": {
    "description": "Demo of the muxy.modal picker API",
    "permissions": ["notifications:write"],
    "background": "background.js",
    "events": ["command.pick"],
    "commands": [
      {
        "id": "pick",
        "title": "Modal Demo: Pick an Item",
        "action": { "kind": "event" },
        "defaultShortcut": "cmd+shift+m"
      }
    ]
  }
}
