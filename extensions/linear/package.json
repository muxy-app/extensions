{
  "name": "linear",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "description": "Muxy extension: browse your assigned Linear issues in a side panel and hand one to Claude Code — branch, worktree, and an issue-aware prompt — without leaving Muxy.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-manifest.mjs"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Browse your Linear issues and hand one to Claude Code — branch, worktree, and prompt — without leaving Muxy.",
    "permissions": [
      "panels:write",
      "tabs:write",
      "panes:read",
      "panes:write",
      "agents:read",
      "commands:exec",
      "git:read",
      "git:write",
      "projects:read",
      "worktrees:read",
      "worktrees:write",
      "files:read",
      "files:write",
      "notifications:write",
      "storage:read",
      "storage:write"
    ],
    "events": [
      "project.switched",
      "worktree.headChanged"
    ],
    "panels": [
      {
        "id": "issues",
        "title": "Linear",
        "icon": {
          "svg": "assets/icon.svg"
        },
        "entry": "panel/index.html",
        "position": "right",
        "mode": "pinned"
      }
    ],
    "tabTypes": [
      {
        "id": "issue",
        "title": "Linear",
        "entry": "tab/issue.html"
      },
      {
        "id": "create",
        "title": "Linear",
        "entry": "tab/create.html"
      }
    ],
    "commands": [
      {
        "id": "toggle-panel",
        "title": "Linear: Toggle Sidebar",
        "action": {
          "kind": "togglePanel",
          "panel": "issues"
        }
      },
      {
        "id": "create-issue",
        "title": "Linear: New Issue",
        "action": {
          "kind": "openTab",
          "tabType": "create"
        }
      },
      {
        "id": "open-settings",
        "title": "Linear: Settings",
        "action": {
          "kind": "openModal",
          "entry": "modals/settings.html",
          "width": 460,
          "height": 520
        }
      },
      {
        "id": "link-project",
        "title": "Linear: Link Current Project",
        "action": {
          "kind": "openModal",
          "entry": "modals/link.html",
          "width": 460,
          "height": 460
        }
      },
      {
        "id": "edit-actions",
        "title": "Linear: Edit Actions",
        "action": {
          "kind": "openModal",
          "entry": "modals/actions.html",
          "width": 560,
          "height": 640
        }
      }
    ],
    "topbarItems": [
      {
        "id": "issues-panel",
        "icon": {
          "svg": "assets/icon.svg"
        },
        "tooltip": "Toggle Linear sidebar",
        "command": "toggle-panel"
      }
    ],
    "marketplace": {
      "author": "namgyung",
      "github": "NamgyungKim",
      "homepage": "https://github.com/NamgyungKim/muxy-linear-extension",
      "repository": "https://github.com/NamgyungKim/muxy-linear-extension",
      "categories": [
        "productivity",
        "git"
      ],
      "icon": "assets/icon.svg",
      "screenshots": [
        "assets/screenshot-1.png"
      ]
    }
  },
  "dependencies": {
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "tiptap-markdown": "^0.9.0",
    "unicode-emoji-json": "^0.9.0"
  }
}
