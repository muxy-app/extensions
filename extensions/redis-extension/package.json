{
  "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
  "name": "redis-extension",
  "version": "0.1.0",
  "description": "Browse and edit Redis keys, run commands, and watch server stats from a right-hand sidebar in Muxy. Finds Redis in Docker and in your project's .env.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "muxy": {
    "description": "Browse and edit Redis keys, run commands, and watch server stats",
    "permissions": [
      "commands:exec",
      "files:read",
      "projects:read",
      "tabs:write",
      "panels:write",
      "storage:read",
      "storage:write"
    ],
    "events": [
      "project.switched",
      "worktree.switched",
      "file.changed"
    ],
    "panels": [
      {
        "id": "redis",
        "title": "Redis",
        "icon": {
          "svg": "assets/redis.svg"
        },
        "entry": "sidebar/index.html",
        "position": "right",
        "mode": "pinned",
        "hiddenControls": [
          "position"
        ],
        "headerButtons": [
          {
            "id": "refresh",
            "icon": "arrow.clockwise",
            "tooltip": "Refresh",
            "command": "refresh"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "toggle-panel",
        "title": "Redis: Toggle Sidebar",
        "subtitle": "keys cache database console valkey panel",
        "action": {
          "kind": "togglePanel",
          "panel": "redis"
        },
        "defaultShortcut": "ctrl+opt+r"
      },
      {
        "id": "refresh",
        "title": "Redis: Refresh",
        "subtitle": "keys server info"
      }
    ],
    "topbarItems": [
      {
        "id": "redis",
        "icon": {
          "svg": "assets/redis.svg"
        },
        "command": "toggle-panel",
        "tooltip": "Redis"
      }
    ],
    "marketplace": {
      "author": "metecan",
      "github": "metecan",
      "categories": [
        "redis",
        "database",
        "cache",
        "valkey"
      ],
      "icon": "icon.svg",
      "screenshots": [
        "screenshots/screenshot-1.png",
        "screenshots/screenshot-2.png"
      ]
    }
  }
}
