{
  "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
  "name": "sticky-notes",
  "version": "0.2.2",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "muxy": {
    "description": "Sticky notes on any edge of the window, with checklists and per-project notes",
    "permissions": [
      "panels:write",
      "projects:read",
      "storage:read",
      "storage:write"
    ],
    "background": "background.js",
    "panels": [
      {
        "id": "dock",
        "title": "Sticky Notes",
        "entry": "dock/index.html",
        "mode": "detached",
        "chrome": "none",
        "transparent": true,
        "clickThrough": true,
        "scope": "global",
        "movable": false,
        "resizable": false,
        "hiddenControls": [
          "detach"
        ],
        "frame": {
          "x": 0,
          "y": 0,
          "width": 1200,
          "height": 800
        }
      }
    ],
    "commands": [
      {
        "id": "new-note",
        "title": "Sticky Notes: New Note",
        "subtitle": "add create sticky note",
        "defaultShortcut": "ctrl+opt+n"
      },
      {
        "id": "toggle-notes",
        "title": "Sticky Notes: Show/Hide Notes",
        "subtitle": "toggle sticky notes",
        "defaultShortcut": "ctrl+opt+shift+n"
      },
      {
        "id": "show-notes",
        "title": "Sticky Notes: Show All Notes"
      },
      {
        "id": "hide-notes",
        "title": "Sticky Notes: Hide All Notes"
      },
      {
        "id": "settings",
        "title": "Sticky Notes: Settings",
        "subtitle": "position edge corner side size move"
      }
    ],
    "topbarItems": [
      {
        "id": "new-note",
        "icon": "note.text.badge.plus",
        "command": "new-note",
        "tooltip": "New Sticky Note"
      }
    ],
    "marketplace": {
      "author": "Saeed Vaziry",
      "github": "saeedvaziry",
      "categories": [
        "productivity"
      ],
      "icon": "assets/icon.svg",
      "screenshots": [
        "assets/screenshot-1.png",
        "assets/screenshot-2.png",
        "assets/screenshot-3.png"
      ]
    },
    "events": [
      "pane.focused",
      "tab.focused",
      "project.switched"
    ]
  }
}
