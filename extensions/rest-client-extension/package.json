{
  "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
  "name": "rest-client-extension",
  "version": "0.1.0",
  "description": "An HTTP/REST client for Muxy. Requests open as editor tabs, and a right-hand sidebar holds open requests, saved collections and folders, environments, and history.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "muxy": {
    "description": "Send HTTP requests from editor tabs, with a sidebar for open requests, collections, environments, and history",
    "permissions": [
      "commands:exec",
      "tabs:read",
      "tabs:write",
      "panels:write",
      "storage:read",
      "storage:write"
    ],
    "events": [
      "tab.created",
      "tab.updated",
      "tab.closed",
      "tab.focused",
      "project.switched",
      "worktree.switched"
    ],
    "background": "background.js",
    "tabTypes": [
      {
        "id": "request",
        "title": "Request",
        "entry": "app/request.html",
        "defaultData": {}
      }
    ],
    "panels": [
      {
        "id": "rest",
        "title": "REST",
        "icon": {
          "svg": "assets/rest.svg"
        },
        "entry": "app/sidebar.html",
        "position": "right",
        "mode": "pinned",
        "hiddenControls": [
          "position"
        ],
        "headerButtons": [
          {
            "id": "new",
            "icon": "plus",
            "tooltip": "New Request",
            "command": "new-request"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "toggle-panel",
        "title": "REST: Toggle Sidebar",
        "subtitle": "http api requests collections environments curl postman panel",
        "action": {
          "kind": "togglePanel",
          "panel": "rest"
        },
        "defaultShortcut": "ctrl+opt+h"
      },
      {
        "id": "new-request",
        "title": "REST: New Request",
        "subtitle": "http api curl get post put patch delete"
      }
    ],
    "topbarItems": [
      {
        "id": "rest",
        "icon": {
          "svg": "assets/rest.svg"
        },
        "command": "toggle-panel",
        "tooltip": "REST Client"
      }
    ],
    "marketplace": {
      "author": "metecan",
      "github": "metecan",
      "repository": "https://github.com/metecan/rest-client-extension",
      "categories": [
        "http",
        "api",
        "rest",
        "developer-tools"
      ],
      "icon": "icon.svg",
      "screenshots": [
        "screenshots/screenshot-1.png",
        "screenshots/screenshot-2.png"
      ]
    }
  }
}
