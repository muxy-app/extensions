{
  "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
  "name": "docker-extension",
  "version": "0.1.0",
  "description": "Manage Docker containers, Compose projects, images, volumes, and networks from a right-hand sidebar in Muxy.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "muxy": {
    "description": "Manage Docker containers, Compose projects, images, volumes, and networks",
    "permissions": [
      "commands:exec",
      "tabs:write",
      "panels:write",
      "storage:read",
      "storage:write"
    ],
    "events": [
      "project.switched"
    ],
    "panels": [
      {
        "id": "docker",
        "title": "Docker",
        "icon": "shippingbox",
        "entry": "sidebar/index.html",
        "position": "right",
        "mode": "pinned",
        "hiddenControls": [
          "position"
        ],
        "headerButtons": [
          {
            "id": "refresh",
            "icon": "arrow.clockwise",
            "tooltip": "Refresh",
            "command": "refresh"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "toggle-panel",
        "title": "Docker: Toggle Sidebar",
        "subtitle": "containers images compose volumes networks panel",
        "action": {
          "kind": "togglePanel",
          "panel": "docker"
        },
        "defaultShortcut": "ctrl+opt+d"
      },
      {
        "id": "refresh",
        "title": "Docker: Refresh",
        "subtitle": "containers images compose"
      }
    ],
    "topbarItems": [
      {
        "id": "docker",
        "icon": "shippingbox",
        "command": "toggle-panel",
        "tooltip": "Docker"
      }
    ],
    "marketplace": {
      "author": "metecan",
      "github": "metecan",
      "repository": "https://github.com/metecan/docker-extension",
      "categories": [
        "docker",
        "containers",
        "devops"
      ],
      "icon": "icon.svg",
      "screenshots": [
        "screenshots/screenshot-1.png"
      ]
    }
  }
}
