{
  "name": "dialog-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Demonstrates native confirm dialogs and alerts from a tab and a background script.",
    "background": "background.js",
    "permissions": ["tabs:write"],
    "tabTypes": [
      { "id": "demo", "title": "Dialog Demo", "entry": "tabs/demo.html" }
    ],
    "commands": [
      { "id": "open", "title": "Dialog Demo: Open Tab", "action": { "kind": "openTab", "tabType": "demo" } },
      { "id": "ping", "title": "Dialog Demo: Background Confirm" }
    ]
  }
}
