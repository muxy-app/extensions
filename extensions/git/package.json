{
  "name": "git",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-scripts.mjs",
    "test": "node --import ./tests/support/alias.mjs --test \"tests/*.test.mjs\"",
    "update-skill": "node scripts/update-skill.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.12",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "vite": "^7.3.5"
  },
  "muxy": {
    "$schema": "https://raw.githubusercontent.com/muxy-app/muxy/main/docs/extensions/schema/manifest.schema.json",
    "description": "Official Git extension for Muxy — GitHub, Forgejo, and Gitea",
    "permissions": [
      "commands:exec",
      "commands:run-script",
      "panels:write",
      "tabs:write",
      "worktrees:read",
      "worktrees:write",
      "notifications:write",
      "files:read",
      "git:read",
      "git:write"
    ],
    "events": [
      "project.switched",
      "worktree.switched",
      "worktree.headChanged",
      "file.changed",
      "panel.opened"
    ],
    "panels": [
      {
        "id": "scm",
        "title": "Source Control",
        "entry": "panel/index.html",
        "icon": {
          "symbol": "arrow.triangle.branch"
        },
        "position": "right",
        "mode": "pinned",
        "headerButtons": [
          {
            "id": "refresh",
            "icon": {
              "symbol": "arrow.clockwise"
            },
            "tooltip": "Refresh",
            "command": "refresh-scm"
          },
          {
            "id": "open-repository",
            "icon": {
              "symbol": "arrow.up.right.square"
            },
            "tooltip": "Open Repository in Browser",
            "command": "open-repository"
          }
        ]
      }
    ],
    "tabTypes": [
      {
        "id": "diff-viewer",
        "title": "Changes",
        "entry": "panel/diff-viewer.html"
      }
    ],
    "commands": [
      {
        "id": "toggle-scm",
        "title": "Toggle Source Control",
        "defaultShortcut": "cmd+y",
        "action": {
          "kind": "togglePanel",
          "panel": "scm"
        }
      },
      {
        "id": "refresh-scm",
        "title": "Git: Refresh"
      },
      {
        "id": "open-repository",
        "title": "Git: Open Repository in Browser"
      },
      {
        "id": "open-diff",
        "title": "Git: Open Changes",
        "subtitle": "Diff of the working tree",
        "action": {
          "kind": "openTab",
          "tabType": "diff-viewer",
          "data": {
            "source": "working",
            "handoff": true
          }
        }
      },
      {
        "id": "create-pr",
        "title": "Git: Create Pull Request…",
        "subtitle": "Commit, push, and open a pull request",
        "action": {
          "kind": "openModal",
          "entry": "modal/create-pr.html",
          "width": 520,
          "height": 440,
          "dismissOnOutsideClick": false
        }
      },
      {
        "id": "checkout-pr",
        "title": "Git: Pull Requests…",
        "subtitle": "Browse, check out, and review pull requests",
        "defaultShortcut": "cmd+shift+y",
        "action": {
          "kind": "openModal",
          "entry": "modal/pr-browser.html",
          "width": 860,
          "height": 620,
          "dismissOnOutsideClick": true
        }
      },
      {
        "id": "switch-branch",
        "title": "Git: Switch Branch…",
        "subtitle": "Switch to or create a branch",
        "action": {
          "kind": "runScript",
          "script": "scripts/switch-branch.js"
        }
      }
    ],
    "topbarItems": [
      {
        "id": "scm",
        "icon": {
          "symbol": "arrow.triangle.branch"
        },
        "tooltip": "Toggle Source Control",
        "command": "toggle-scm"
      }
    ],
    "marketplace": {
      "author": "Saeed Vaziry",
      "github": "saeedvaziry",
      "repository": "https://github.com/muxy-app/extensions",
      "categories": [
        "git",
        "source-control"
      ],
      "icon": "icon.svg",
      "screenshots": [
        "screenshots/screenshot-1.png",
        "screenshots/screenshot-2.png"
      ]
    }
  }
}
